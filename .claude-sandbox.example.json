{
  "plugins": {
    "data-mounts": {
      "mounts": ["/srv/datasets:/data:ro", "~/scratch:/scratch"]
    },
    "git-workspace": {
      "branchPrefix": "sandbox"
    },
    "upstream-proxy": {
      "envFile": ".env",
      "routes": [
        {
          "name": "cribl",
          "port": 8081,
          "upstream": "${CRIBL_SERVER_URL}",
          "allowMethods": ["GET"],
          "allowPaths": ["/api/v1/"],
          "auth": {
            "type": "oauth2_client_credentials",
            "tokenUrl": "https://login.cribl.cloud/oauth/token",
            "audience": "https://api.cribl.cloud",
            "clientIdEnv": "CRIBL_CLIENT_ID",
            "clientSecretEnv": "CRIBL_CLIENT_SECRET"
          },
          "containerEnv": {
            "CRIBL_SERVER_URL": "http://127.0.0.1:8081",
            "CRIBL_BEARER_TOKEN": "proxied-on-the-host"
          }
        },
        {
          "name": "azure-openai",
          "port": 8082,
          "upstream": "${AZURE_OPENAI_ENDPOINT}",
          "allowMethods": ["POST"],
          "allowPaths": ["/openai/"],
          "auth": {
            "type": "header",
            "header": "api-key",
            "valueEnv": "AZURE_OPENAI_API_KEY"
          },
          "containerEnv": {
            "AZURE_OPENAI_ENDPOINT": "http://127.0.0.1:8082",
            "AZURE_OPENAI_API_KEY": "proxied-on-the-host",
            "AZURE_OPENAI_EMBEDDING_DEPLOYMENT": "${AZURE_OPENAI_EMBEDDING_DEPLOYMENT}",
            "AZURE_OPENAI_API_VERSION": "${AZURE_OPENAI_API_VERSION}"
          }
        },
        {
          "name": "gcs",
          "port": 8083,
          "upstream": "https://storage.googleapis.com",
          "allowMethods": ["GET", "HEAD"],
          "allowPaths": ["/storage/v1/b/my-bucket/o", "/download/storage/v1/b/my-bucket/o"],
          "auth": {
            "type": "gcp",
            "serviceAccount": "sandbox-reader@my-project.iam.gserviceaccount.com",
            "accessBoundary": {
              "accessBoundaryRules": [{
                "availableResource": "//storage.googleapis.com/projects/_/buckets/my-bucket",
                "availablePermissions": ["inRole:roles/storage.objectViewer"]
              }]
            }
          },
          "containerEnv": {
            "STORAGE_EMULATOR_HOST": "http://127.0.0.1:8083",
            "CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGE": "http://127.0.0.1:8083/storage/v1/"
          }
        }
      ]
    },
    "project-deps": {
      "apt": ["ripgrep", "postgresql-client"],
      "npm": ["pnpm@9"],
      "pip": ["ruff"],
      "setup": ["pnpm install --frozen-lockfile", "make bootstrap"]
    }
  }
}
