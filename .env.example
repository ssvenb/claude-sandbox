# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- core ------------------------------------------------------------------------------------

# Which CLI agent runs in the sandbox: a directory name under agents/ (claude, copilot).
# Each agent brings its own credentials and its own image tag. Default: claude.
AGENT=claude

# --- agents ----------------------------------------------------------------------------------

# claude — Claude Code OAuth token, generate with `claude setup-token`. Not needed while the
# claude-home plugin mounts a ~/.claude that already holds credentials.
CLAUDE_CODE_OAUTH_TOKEN=

# copilot — GitHub token for Copilot CLI: a fine-grained PAT with the "Copilot Requests"
# permission, or an OAuth token from the Copilot CLI / gh app. Classic PATs and the GitHub App
# installation tokens minted by the github-auth plugin are NOT accepted.
COPILOT_GITHUB_TOKEN=

# --- plugins ---------------------------------------------------------------------------------
# Each plugin under plugins/ has an ENABLE_<NAME> switch. Leave a flag out to use that plugin's
# own default (all three below default to on). A plugin's variables only matter while it is on.
# A plugin that declares a requiredAgent is skipped when another agent runs.

# github-auth — mints short-lived GitHub App installation tokens from a key held on this machine.
ENABLE_GITHUB_AUTH=1

# GitHub App id (Settings → Developer settings → GitHub Apps → your app).
GH_APP_ID=123456

# Path on the HOST to the App's .pem private key. Never enters the container; run.sh reads it
# and the container only ever sees short-lived installation tokens minted from it.
GH_PRIVATE_KEY_FILE=./plugins/github-auth/claude-agent.private-key.pem

# GitHub host. Use your Enterprise Server hostname (e.g. github.mycorp.com) to target GHES.
GH_HOST=github.com

# git-workspace — clones the repo into /workspace and cuts a per-run claude-code/<id> branch.
# Needs a plugin providing git credentials. Turn it off to start the agent in an empty /workspace.
ENABLE_GIT_WORKSPACE=1

# https clone URL of the repo the agent works on.
REPO_URL=https://github.com/your-org/your-repo.git

# Branch new agent branches are cut from.
BASE_BRANCH=main

# cwd-workspace — bind-mounts the host directory run.sh is invoked from at /workspace instead of
# cloning. Mutually exclusive with git-workspace: edits are live on the host, with no branch
# isolation. Off by default.
ENABLE_CWD_WORKSPACE=0

# Host directory to mount as /workspace (default: the directory you run ./run.sh from).
HOST_WORKSPACE_DIR=

# branch-guard — PreToolUse hook pinning the agent to its own branch. Needs git-workspace.
# Requires AGENT=claude.
ENABLE_BRANCH_GUARD=1

# headroom — routes Claude's LLM calls through the local headroom compression proxy.
# Requires AGENT=claude.
ENABLE_HEADROOM=1

# claude-home — mounts the host's Claude config dir into the container's /home/node/.claude.
# Requires AGENT=claude.
ENABLE_CLAUDE_HOME=1

# Host directory mounted as the agent's ~/.claude (default: $HOME/.claude).
CLAUDE_HOME_DIR=

# docker-cli — ships the docker CLI + compose plugin in the image.
ENABLE_DOCKER_CLI=1

# netbird — joins the container to a private NetBird mesh as its own peer (own netns, own
# WireGuard interface). Needs /dev/net/tun and NET_ADMIN, both added automatically. Off by default.
ENABLE_NETBIRD=0

# Setup key the peer enrols with. Mint it in the NetBird dashboard (or with Terraform on this
# machine) — preferably ephemeral, so the peer disappears with the container, and reusable if you
# use --resume. The NetBird PAT must never go in here: only the setup key enters the container.
NB_SETUP_KEY=

# Self-hosted NetBird management server. Leave empty for NetBird Cloud.
NB_MANAGEMENT_URL=

# Peer name in the NetBird dashboard (default: sandbox-<RUN_ID>).
NB_HOSTNAME=

# s3-auth — mints short-lived AWS credentials on this machine and passes only those in. Off by
# default. The container gets no way to renew them: when they expire, restart the sandbox.
ENABLE_S3_AUTH=0

# Role assumed for the sandbox session — scope it to exactly the buckets the agent may touch.
# Leave empty to export the host profile's current credentials instead (long-lived keys if that
# profile has no session, which the run warns about).
S3_ROLE_ARN=

# Lifetime of the assumed-role session, in seconds (default 3600; the role's own max applies).
S3_SESSION_DURATION=3600

# Region handed to the container (falls back to AWS_DEFAULT_REGION, then us-east-1), and the host
# profile used for minting (empty = the host's default profile).
AWS_REGION=eu-central-1
AWS_PROFILE=

# S3-compatible (non-AWS) endpoint, e.g. https://s3.eu-central-1.ionoscloud.com. Empty for AWS.
S3_ENDPOINT_URL=

# Bucket the agent is meant to work with. Informational only — it is named in the agent's
# briefing; what the agent may actually do is decided by the role's policy.
S3_BUCKET=

# ssh-credentials — installs an SSH key and client config for the agent. Off by default. Use a key
# dedicated to the sandbox: unlike a token, it cannot be exchanged for a short-lived derivative, so
# the agent holds the key itself for the life of the container.
ENABLE_SSH_CREDENTIALS=0

# Path on the HOST to the private key. Must not be passphrase-protected — the sandbox boots
# unattended and cannot unlock it. Never enters the image; run.sh reads it and passes the contents.
SSH_PRIVATE_KEY_FILE=./plugins/ssh-credentials/sandbox-key

# ~/.ssh/config stanza written for the agent: hosts the key is offered for, the login user, and a
# domain appended to bare names (SSH_HOST_SUFFIX=netbird.cloud makes `ssh my-vm` reach
# my-vm.netbird.cloud).
SSH_HOST_PATTERN=*
SSH_HOST_USER=
SSH_HOST_SUFFIX=

# Path on the HOST to a known_hosts file pinning the peers' host keys. Empty means
# trust-on-first-use (StrictHostKeyChecking=accept-new), since the sandbox boots unattended.
SSH_KNOWN_HOSTS_FILE=
