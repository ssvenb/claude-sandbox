# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- core ------------------------------------------------------------------------------------

# Which CLI agent runs in the sandbox: a directory name under agents/ (claude, copilot).
# Each agent brings its own credentials and its own image tag. Default: claude.
AGENT=claude

# --- agents ----------------------------------------------------------------------------------

# claude — Claude Code OAuth token, generate with `claude setup-token`. Not needed while the
# claude-home plugin mounts a ~/.claude that already holds credentials.
CLAUDE_CODE_OAUTH_TOKEN=

# copilot — GitHub token for Copilot CLI: a fine-grained PAT with the "Copilot Requests"
# permission, or an OAuth token from the Copilot CLI / gh app. Classic PATs and the GitHub App
# installation tokens minted by the github-auth plugin are NOT accepted.
COPILOT_GITHUB_TOKEN=

# --- plugins ---------------------------------------------------------------------------------
# Each plugin under plugins/ has an ENABLE_<NAME> switch. Leave a flag out to use that plugin's
# own default (all three below default to on). A plugin's variables only matter while it is on.
# A plugin that declares a requiredAgent is skipped when another agent runs.

# github-auth — mints short-lived GitHub App installation tokens from a key held on this machine.
ENABLE_GITHUB_AUTH=1

# GitHub App id (Settings → Developer settings → GitHub Apps → your app).
GH_APP_ID=123456

# Path on the HOST to the App's .pem private key. Never enters the container; run.sh reads it
# and the container only ever sees short-lived installation tokens minted from it.
GH_PRIVATE_KEY_FILE=./plugins/github-auth/claude-agent.private-key.pem

# GitHub host. Use your Enterprise Server hostname (e.g. github.mycorp.com) to target GHES.
GH_HOST=github.com

# git-workspace — clones the repo into /workspace and cuts a per-run claude-code/<id> branch.
# Needs a plugin providing git credentials. Turn it off to start the agent in an empty /workspace.
ENABLE_GIT_WORKSPACE=1

# https clone URL of the repo the agent works on.
REPO_URL=https://github.com/your-org/your-repo.git

# Branch new agent branches are cut from.
BASE_BRANCH=main

# cwd-workspace — bind-mounts the host directory run.sh is invoked from at /workspace instead of
# cloning. Mutually exclusive with git-workspace: edits are live on the host, with no branch
# isolation. Off by default.
ENABLE_CWD_WORKSPACE=0

# Host directory to mount as /workspace (default: the directory you run ./run.sh from).
HOST_WORKSPACE_DIR=

# branch-guard — PreToolUse hook pinning the agent to its own branch. Needs git-workspace.
# Requires AGENT=claude.
ENABLE_BRANCH_GUARD=1

# headroom — routes Claude's LLM calls through the local headroom compression proxy.
# Requires AGENT=claude.
ENABLE_HEADROOM=1

# claude-home — mounts the host's Claude config dir into the container's /home/node/.claude.
# Requires AGENT=claude.
ENABLE_CLAUDE_HOME=1

# Host directory mounted as the agent's ~/.claude (default: $HOME/.claude).
CLAUDE_HOME_DIR=

# docker-cli — ships the docker CLI + compose plugin in the image.
ENABLE_DOCKER_CLI=1
