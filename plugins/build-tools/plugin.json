{
  "name": "build-tools",
  "description": "Installs tools into the image at build time: the recipes picked in tools (all of them when unset) and the apt, npm and pip packages listed.",
  "priority": 25,
  "defaultEnabled": true,
  "provides": [
    "build-tools"
  ],
  "requires": [],
  "requiredEnv": [],
  "settings": [
    {
      "key": "tools",
      "type": "list",
      "items": {
        "type": "enum",
        "choices": [
          "python-pip",
          "terraform",
          "ruff",
          "chromium",
          "playwright"
        ]
      },
      "label": "Tools",
      "description": "Built into the image. Unset: all of them; an empty list: none."
    },
    {
      "key": "apt",
      "type": "list",
      "items": {
        "type": "string",
        "placeholder": "ripgrep",
        "monospace": true
      },
      "label": "apt packages",
      "description": "Built into the image."
    },
    {
      "key": "npm",
      "type": "list",
      "items": {
        "type": "string",
        "placeholder": "pnpm@9",
        "monospace": true
      },
      "label": "npm packages",
      "description": "Installed globally, into the image."
    },
    {
      "key": "pip",
      "type": "list",
      "items": {
        "type": "string",
        "placeholder": "uv",
        "monospace": true
      },
      "label": "pip packages",
      "description": "Installed into the image (pip itself comes along when missing)."
    }
  ]
}
