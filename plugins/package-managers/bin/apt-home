#!/bin/sh
# apt-home <package>...: install Debian packages into ~/.local without root. Downloads each with the
# dependencies the image lacks and unpacks them; their maintainer scripts never run, so whatever a
# package sets up at install time (users, services, alternatives) does not happen.
set -eu

[ $# -gt 0 ] || { echo "usage: apt-home <package>..." >&2; exit 2; }
for p in "$@"; do
  case $p in -*|*/*) echo "apt-home: '$p' is not a package name" >&2; exit 2 ;; esac
done

state="$HOME/.cache/apt-home"
mkdir -p "$state/lists/partial" "$state/archives/partial"
apt() {
  "$@" -o Dir::State::Lists="$state/lists" -o Dir::Cache="$state" \
       -o Dir::Cache::archives="$state/archives" -o Debug::NoLocking=1
}

# Package lists once an hour at most.
if [ -z "$(find "$state/lists" -maxdepth 1 -name '*Packages*' -mmin -60 2>/dev/null)" ]; then
  apt apt-get update -qq 2>"$state/update.err" || { cat "$state/update.err" >&2; exit 1; }
  # The image's docker-clean hook tries to empty the system's apt cache after every update.
  grep -v "^rm: cannot remove '/var/cache/apt" "$state/update.err" >&2 || true
fi

# Real packages only (virtual ones print as <name>), minus what the image already has.
# shortcut: a virtual dependency's provider is not fetched, upgrade if a common package needs one.
deps=$(apt apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks \
         --no-replaces --no-enhances "$@") || exit 1
need=""
for p in $(printf '%s\n' "$deps" | grep -v '^[ <]' | sort -u); do
  dpkg-query -W -f '${Status}' "$p" 2>/dev/null | grep -q 'ok installed' || need="$need $p"
done
[ -n "$need" ] || { echo "apt-home: already installed: $*"; exit 0; }

cd "$state/archives"
rm -f ./*.deb
# shellcheck disable=SC2086  # one argument per package
apt apt-get download -q $need
for deb in ./*.deb; do
  dpkg-deb -x "$deb" "$HOME/.local"
  echo "apt-home: unpacked ${deb#./}"
done
